# Copiá este archivo como .env y completá los valores de tu máquina.
#   Copy-Item .\airflow\.env.ejemplo .\airflow\.env
# El .env real está en .gitignore: nunca se sube al repo.

# Credenciales de Google Cloud, de solo lectura dentro del contenedor.
# En Windows, si usás las credenciales personales de gcloud:
#   C:/Users/TU_USUARIO/AppData/Roaming/gcloud/application_default_credentials.json
# En Linux o Mac:
#   /home/TU_USUARIO/.config/gcloud/application_default_credentials.json
# Con una cuenta de servicio, la ruta al archivo .json que te dio GCP.
GCP_CREDENCIALES=C:/Users/TU_USUARIO/AppData/Roaming/gcloud/application_default_credentials.json

# Carpeta donde vive tu profiles.yml de dbt. Se monta en el contenedor.
# Windows:  C:/Users/TU_USUARIO/.dbt
# Linux/Mac: /home/TU_USUARIO/.dbt
DBT_PROFILES=C:/Users/TU_USUARIO/.dbt

# Usuario con el que corre Airflow adentro del contenedor.
# En Windows dejalo en 50000. En Linux o Mac, para que los archivos que
# escriba en logs/ y data/ te pertenezcan, poné el tuyo: id -u
AIRFLOW_UID=50000